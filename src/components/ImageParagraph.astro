---
import { Image } from "astro:assets";

interface Props {
  class?: string;
  src: string;
  alt: string;
  width?: number;
  height?: number;
  side?: "left" | "right";
  credit?: string;
}

const {
  class: className = "",
  src,
  alt,
  side = "left",
  width = 150,
  height = 150,
  credit,
} = Astro.props;

const direction = side === "right" ? "sm:flex-row-reverse" : "sm:flex-row";
---

<div class={`my-8 flex flex-col items-center gap-4 ${direction} ${className}`}>
  <div class="flex shrink-0 flex-col items-center self-center">
    <Image
      src={src}
      alt={alt}
      width={width}
      height={height}
      densities={[1, 1.5, 2]}
      class="not-prose rounded object-cover"
      style={`width:${width}px;height:auto;`}
    />

    {credit && (
      <p class="mt-1 text-center text-xs text-gray-500">
        {credit}
      </p>
    )}
  </div>

  <div class="text-center [&>p]:my-0">
    <slot />
  </div>
</div>